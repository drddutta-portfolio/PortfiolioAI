# Public browser configuration. Use the project's anon or publishable key here,
# never a service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Optional canonical frontend origin used in password-reset redirect emails.
# Omit locally to use window.location.origin.
VITE_APP_URL=http://localhost:5173
VITE_MARKET_DATA_ENABLED=false
VITE_HISTORY_API_URL=https://portfolioai-history-dev-api.dr-d-dutta.workers.dev

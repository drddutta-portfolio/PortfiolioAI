{
  "name": "portfolioai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "lint:architecture": "eslint src/contracts src/data/dashboardEvidenceRepository.ts src/features/dashboard/useDashboardEvidence.ts src/features/portfolio/sharedClassification.ts src/features/portfolio/usePortfolioView.ts src/features/research/sectorResearchMapping.ts src/features/research/portfolioCoverageProjection.ts src/components/DashboardAllocationPerformance.tsx src/components/DashboardCoreExitRisk.tsx src/components/DashboardDailyMovement.tsx src/components/DashboardDecisionLayer.tsx src/components/DashboardMonitoringReadiness.tsx src/components/DashboardNewsPreview.tsx src/components/DashboardPortfolioIntelligence.tsx scripts/check-data-boundaries.mjs",
    "check:architecture": "node scripts/check-data-boundaries.mjs",
    "lint:edge": "eslint --config eslint.edge.config.js supabase/functions",
    "test:edge": "vitest run --config vitest.edge.config.ts",
    "test": "vitest run",
    "r4n:preflight:numeric": "bash scripts/r4n/run-torntpharm-local-numeric-preflight.sh",
    "r4n:replay:regulatory": "bash scripts/r4n/run-regulatory-event-migration-replay.sh",
    "r4n:dry-run:prerequisites": "node scripts/r4n/torntpharm-prerequisite-materialization-dry-run.mjs",
    "r4n:mutate:prerequisites": "bash scripts/r4n/run-torntpharm-local-prerequisite-mutation.sh",
    "r4n:mutate:observations": "bash scripts/r4n/run-torntpharm-local-observation-mutation.sh"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@supabase/supabase-js": "^2.115.0",
    "decimal.js": "^10.6.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
